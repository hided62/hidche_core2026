{
    "name": "@sammo-ts/common",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./auth/gameToken": {
            "types": "./dist/auth/gameToken.d.ts",
            "default": "./dist/auth/gameToken.js"
        },
        "./auth/sanctions": {
            "types": "./dist/auth/sanctions.d.ts",
            "default": "./dist/auth/sanctions.js"
        },
        "./auth/gameSessionTransfer": {
            "types": "./dist/auth/gameSessionTransfer.d.ts",
            "default": "./dist/auth/gameSessionTransfer.js"
        },
        "./navigation/menuConfig": {
            "types": "./dist/navigation/menuConfig.d.ts",
            "default": "./dist/navigation/menuConfig.js"
        }
    },
    "scripts": {
        "build": "tsdown -c ./tsdown.config.ts",
        "dev": "tsdown -c ./tsdown.config.ts --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run --config vitest.config.ts",
        "typecheck": "pnpm -w tsc7 -b packages/common/tsconfig.json"
    },
    "dependencies": {
        "@noble/hashes": "^2.0.1",
        "es-toolkit": "^1.43.0",
        "rfc6902": "^5.3.0"
    },
    "devDependencies": {
        "tsdown": "^0.22.14",
        "vitest": "^4.1.10"
    }
}
