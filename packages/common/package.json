{
    "name": "@sammo-ts/common",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsdown -c ../../tsdown.config.ts -F @sammo-ts/common",
        "dev": "tsdown -c ../../tsdown.config.ts -F @sammo-ts/common --watch",
